# Copy to .env and fill in. Never commit .env.
#
# Two API shapes are supported:
#   provider=openai     any OpenAI-compatible /chat/completions endpoint --
#                       OpenAI, Groq, OpenRouter, Together, local Ollama
#   provider=anthropic  the Anthropic Messages API
#
# Extraction and reasoning are configured separately because they are different jobs.
# Extraction is ~1,000 high-volume, low-judgement calls per corpus, and the grounding gate
# catches what a weaker model gets wrong. Reasoning is a few hundred calls where the
# model's judgement decides the output. Spend the better model only where it changes
# the answer.
#
# Set only the generic CROSSCHECK_* keys below if you want one model for both.

# ---- Extraction --------------------------------------------------------------
# gpt-5-nano needs reasoning_effort=minimal explicitly: left at its default it spends
# its whole output budget on internal reasoning and returns nothing.
CROSSCHECK_EXTRACT_PROVIDER=openai
CROSSCHECK_EXTRACT_BASE_URL=https://api.openai.com/v1
CROSSCHECK_EXTRACT_API_KEY=sk-...
CROSSCHECK_EXTRACT_MODEL=gpt-5-nano
CROSSCHECK_EXTRACT_REASONING_EFFORT=minimal

# Free alternative that scored *higher* on grounding in early pilots (its quote-copying
# fidelity is better than either mini model tried). Capped at 200,000 tokens/day on the
# free tier, though, which is below what six documents need in one sitting -- the
# corpus's own daily budget ran out mid-testing. Caching makes resuming across days free.
# CROSSCHECK_EXTRACT_BASE_URL=https://api.groq.com/openai/v1
# CROSSCHECK_EXTRACT_API_KEY=gsk_...
# CROSSCHECK_EXTRACT_MODEL=openai/gpt-oss-120b
# CROSSCHECK_EXTRACT_REASONING_EFFORT=low

# ---- Reconciliation ----------------------------------------------------------
CROSSCHECK_REASON_PROVIDER=openai
CROSSCHECK_REASON_BASE_URL=https://api.openai.com/v1
CROSSCHECK_REASON_API_KEY=sk-...
CROSSCHECK_REASON_MODEL=gpt-4.1-mini

# ---- Anthropic, for either role ----------------------------------------------
# CROSSCHECK_REASON_PROVIDER=anthropic
# CROSSCHECK_REASON_BASE_URL=https://api.anthropic.com
# CROSSCHECK_REASON_API_KEY=sk-ant-...
# CROSSCHECK_REASON_MODEL=claude-sonnet-5

# ---- Local, no key -----------------------------------------------------------
# CROSSCHECK_EXTRACT_BASE_URL=http://localhost:11434/v1
# CROSSCHECK_EXTRACT_API_KEY=ollama
# CROSSCHECK_EXTRACT_MODEL=qwen2.5:14b

# ---- Tuning ------------------------------------------------------------------
CROSSCHECK_CONCURRENCY=6
# Hard ceiling on model calls per command; 0 disables. A runaway loop against a paid
# endpoint is an expensive way to find a bug.
CROSSCHECK_MAX_CALLS=0
CROSSCHECK_TIMEOUT=120
CROSSCHECK_DB=data/crosscheck.db
CROSSCHECK_DATA_DIR=data
