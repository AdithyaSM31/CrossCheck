# Copy to .env and fill in. Never commit .env.
#
# CrossCheck talks to two API shapes:
#   provider=anthropic  -> Anthropic Messages API
#   provider=openai     -> any OpenAI-compatible /chat/completions endpoint,
#                          which covers Groq, OpenAI, OpenRouter, Together and Ollama.

# ---- Option A: Groq (free tier) ----------------------------------------
CROSSCHECK_PROVIDER=openai
CROSSCHECK_BASE_URL=https://api.groq.com/openai/v1
CROSSCHECK_API_KEY=gsk_...
CROSSCHECK_EXTRACT_MODEL=llama-3.3-70b-versatile
CROSSCHECK_REASON_MODEL=llama-3.3-70b-versatile

# ---- Option B: Anthropic ------------------------------------------------
# CROSSCHECK_PROVIDER=anthropic
# CROSSCHECK_BASE_URL=https://api.anthropic.com
# CROSSCHECK_API_KEY=sk-ant-...
# CROSSCHECK_EXTRACT_MODEL=claude-haiku-4-5-20251001
# CROSSCHECK_REASON_MODEL=claude-sonnet-5

# ---- Option C: local Ollama (no key) ------------------------------------
# CROSSCHECK_PROVIDER=openai
# CROSSCHECK_BASE_URL=http://localhost:11434/v1
# CROSSCHECK_API_KEY=ollama
# CROSSCHECK_EXTRACT_MODEL=qwen2.5:14b
# CROSSCHECK_REASON_MODEL=qwen2.5:14b

# Tuning. Lower concurrency on Groq's free tier, which limits tokens-per-minute.
CROSSCHECK_CONCURRENCY=4
CROSSCHECK_DB=data/crosscheck.db
CROSSCHECK_DATA_DIR=data
